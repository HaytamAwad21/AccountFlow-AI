# ─── AccountFlow AI configuration ─────────────────────────────────────────────
# Copy to `.env` (repo root) and adjust. Every value is optional: the defaults run
# the full demo locally with SQLite, the offline Vision simulator and the in-app
# WhatsApp phone simulator.

FIRM_NAME="כהן ושות׳ - רואי חשבון"
TIMEZONE=Asia/Jerusalem

# Database — SQLite file by default; switch to PostgreSQL with zero code changes:
# DATABASE_URL=postgresql+psycopg://accountflow:accountflow@localhost:5432/accountflow
SEED_ON_STARTUP=true

# 48h nagging engine
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
REMINDER_INTERVAL_HOURS=48
URGENT_REMINDER_INTERVAL_HOURS=24
URGENT_DEADLINE_DAYS=3
DEFAULT_MAX_REMINDERS=3
SNOOZE_HOUR=20

# Accounting rules
# Initial values only: managers change these live in the Settings tab (system_settings table)
VAT_RATE=0.18
ALLOCATION_NUMBER_THRESHOLD_NIS=10000
# The VAT deadline is fixed by law to the 26th of the reporting month (not configurable)
AUTO_APPROVE_VERIFIED=false
DEFAULT_PAYMENT_LINK=https://www.gov.il/he/departments/israel_tax_authority

# Login sessions
SESSION_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Password given to pre-existing users that have none (after upgrading an older database)
INITIAL_USER_PASSWORD=ChangeMe123

# Vision AI: auto | openai | gemini | local
VISION_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
BLUR_THRESHOLD=60

# WhatsApp Cloud API (Meta). Leave empty for simulator-only mode.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=accountflow-verify
WHATSAPP_API_VERSION=v21.0
DEFAULT_COUNTRY_CODE=972

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
