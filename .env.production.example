# ─── AccountFlow AI: settings for a real office server ────────────────────────
# deploy/setup.sh copies this file to `.env` and fills in DOMAIN, the passwords and the OpenAI key.
# You can also copy it by hand: cp .env.production.example .env  (then replace every CHANGE_ME).
# Keep `.env` private: it holds the database password and the API keys. It is never committed.

# The address of the office's site, without https:// (its DNS A record must point at this server)
DOMAIN=CHANGE_ME.example.co.il

# Database password: letters and digits only (setup.sh generates one)
POSTGRES_PASSWORD=CHANGE_ME

# Code the first manager types on the setup screen; useless once the office is set up (setup.sh generates one)
SETUP_CODE=CHANGE_ME

TIMEZONE=Asia/Jerusalem

# Vision AI: reads invoice photos. Get a key at platform.openai.com (pay-as-you-go billing, set a monthly limit).
VISION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Cloud API (Meta), see DEPLOY.md "Connect WhatsApp". Until these are set, messages appear only
# in the in-app phone simulator and nothing reaches real clients.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any text you choose; type the same text in the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
# Meta App Secret (App settings > Basic); Meta webhook posts are refused while it is empty
WHATSAPP_APP_SECRET=
# Approved Hebrew template for clients whose 24-hour window is closed (README > The 24-hour window)
WHATSAPP_REENGAGE_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=he

# Nagging engine (managers change the office rules on the Settings tab; these are only the first values)
SCHEDULER_ENABLED=true
REMINDER_INTERVAL_HOURS=48
URGENT_REMINDER_INTERVAL_HOURS=24

# Login
SESSION_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Backups are encrypted with this passphrase (setup.sh generates one). Keep a copy OUTSIDE the server, for
# example in a password manager: without it no backup can be restored, also not by you.
BACKUP_PASSPHRASE=CHANGE_ME
# How many days of nightly backups to keep, on the server and off it
BACKUP_KEEP_DAYS=14

# Off-site copy of every backup (recommended): an rclone remote named "offsite" plus a folder in it.
# Any S3-compatible storage works (AWS S3, Cloudflare R2, Backblaze B2, Wasabi). Example for AWS S3 in Tel Aviv;
# create a bucket and an access key that can only write to it, then remove the # signs:
# BACKUP_REMOTE=offsite:levi-cpa-backups/accountflow
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=AWS
# RCLONE_CONFIG_OFFSITE_REGION=il-central-1
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# For Cloudflare R2 or Backblaze B2 use PROVIDER=Cloudflare / Other and add RCLONE_CONFIG_OFFSITE_ENDPOINT=<their URL>.
BACKUP_REMOTE=
